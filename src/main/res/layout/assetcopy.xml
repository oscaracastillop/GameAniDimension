<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/activity_main"
	android:layout_width="match_parent"
	android:layout_height="match_parent">

	<!-- Fondo tematico Ani Dimension -->
	<ImageView
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:src="@drawable/bg_update"
		android:scaleType="centerCrop" />

	<!-- Capa oscura semitransparente para legibilidad -->
	<View
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:background="#80000000" />

	<!-- Contenedor central -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_centerInParent="true"
		android:orientation="vertical"
		android:gravity="center_horizontal"
		android:paddingLeft="40dp"
		android:paddingRight="40dp">

		<!-- Logo oficial Ani Dimension -->
		<ImageView
			android:id="@+id/logoView"
			android:layout_width="240dp"
			android:layout_height="80dp"
			android:src="@drawable/logo"
			android:scaleType="fitCenter"
			android:layout_marginBottom="20dp" />

		<!-- Barra de progreso de carga/actualizacion -->
		<ProgressBar
			android:id="@+id/progressBar1"
			style="?android:attr/progressBarStyleHorizontal"
			android:layout_width="match_parent"
			android:layout_height="14dp"
			android:layout_marginLeft="40dp"
			android:layout_marginRight="40dp" />

		<!-- Texto de estado -->
		<TextView
			android:id="@+id/textView1"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="12dp"
			android:textColor="#FFFFFF"
			android:textSize="14sp"
			android:textStyle="bold"
			android:shadowColor="#000000"
			android:shadowRadius="4"
			android:shadowDx="1"
			android:shadowDy="1"
			android:text="@string/preparing_media" />

	</LinearLayout>

</RelativeLayout>
